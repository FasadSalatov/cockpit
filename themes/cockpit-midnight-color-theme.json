    "quickInput.foreground": "#d3e0ea",
    "quickInputTitle.background": "#0b1928",
    "quickInputList.focusBackground": "#172839",
    "quickInputList.focusForeground": "#d3e0ea",
    "editorLink.activeForeground": "#91acff",
    "textLink.foreground": "#91acff",
    "textLink.activeForeground": "#eb98cf",
    "textBlockQuote.background": "#0b1928",
    "textBlockQuote.border": "#4d97de",
    "textCodeBlock.background": "#0b1928",
    "textPreformat.foreground": "#73d4ac",
    "widget.shadow": "#00000066"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#576574",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#73d4ac"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character"
      ],
      "settings": {
        "foreground": "#e5ab66"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new",
        "keyword.operator.expression"
      ],
      "settings": {
        "foreground": "#91acff"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic"
      ],
      "settings": {
        "foreground": "#4cd1ee"
      }
    },
    {
      "scope": [
        "entity.name.class",
        "entity.name.type",
        "support.class",
        "support.type",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#69c1fc"
      }
    },
    {
      "scope": [
        "variable",
        "variable.parameter",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#d3e0ea"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#f19fd6"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace",
        "meta.delimiter"
      ],
      "settings": {
        "foreground": "#7a93a6"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#fb9989"
      }
    },
    {
      "scope": [
        "constant.character.escape",
        "constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#e5ab66"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#e3b667"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "meta.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#80b1ff"
      }
    },
    {
      "scope": [
        "markup.heading",
        "markup.heading punctuation.definition.heading"
      ],
      "settings": {
        "foreground": "#e3a2f2",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code",
        "markup.raw"
      ],
      "settings": {
        "foreground": "#73d4ac"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#4cd1ee",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.inserted",
        "markup.changed"
      ],
      "settings": {
        "foreground": "#73d4ac"
      }
    },
    {
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#ff6661"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ff6661",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "emphasis"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "strong"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    }
  ],
  "semanticTokenColors": {
    "variable": "#d3e0ea",
    "parameter": "#d3e0ea",
    "property": "#f19fd6",
    "function": "#4cd1ee",
    "method": "#4cd1ee",
    "function.declaration": "#4cd1ee",
    "class": "#69c1fc",
    "type": "#69c1fc",
    "interface": "#69c1fc",
    "enum": "#69c1fc",
    "enumMember": "#e5ab66",
    "typeParameter": "#69c1fc",
    "namespace": "#69c1fc",
    "macro": "#91acff",
    "keyword": "#91acff",
    "string": "#73d4ac",
    "number": "#e5ab66",
    "comment": {
      "foreground": "#576574",
      "fontStyle": "italic"
    },
    "variable.readonly": "#d3e0ea",
    "variable.defaultLibrary": "#69c1fc"
  }
}
